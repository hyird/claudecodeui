{
  "name": "cloudcli-terminal-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"bun server/index.js\" \"vite --host 0.0.0.0\"",
    "server": "bun server/index.js",
    "build": "bun run build:web && bun run build:server",
    "build:web": "tsc --noEmit && vite build",
    "build:server": "bun build server/index.js --target=bun --outfile dist-server/server.js",
    "preview": "vite preview --host 0.0.0.0",
    "start": "bun server/index.js",
    "test": "node --test \"server/*.test.js\" \"src/**/*.test.js\" && bun test spec",
    "proto": "pbjs -t static-module -w es6 -o proto/messages.js proto/messages.proto && pbts -o proto/messages.d.ts proto/messages.js"
  },
  "dependencies": {
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "bun-pty": "^0.4.10",
    "hono": "^4.12.27",
    "lucide-react": "^0.468.0",
    "protobufjs": "^8.6.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "protobufjs-cli": "^2.5.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0",
    "ws": "^8.18.0"
  }
}
