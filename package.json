{
  "name": "cloudcli-terminal-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"bun run server\" \"bun run client\"",
    "server": "bun run server/index.js",
    "client": "bun --bun vite --host 0.0.0.0",
    "build": "bun --bun tsc --noEmit && bun --bun vite build",
    "preview": "bun --bun vite preview --host 0.0.0.0",
    "start": "bun run server/index.js",
    "test": "bun test server/",
    "proto": "pbjs -t static-module -w es6 -o proto/messages.js proto/messages.proto && pbts -o proto/messages.d.ts proto/messages.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "bun-pty": "^0.4.10",
    "hono": "^4.12.27",
    "lucide-react": "^0.468.0",
    "protobufjs": "^8.6.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "protobufjs-cli": "^2.5.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
