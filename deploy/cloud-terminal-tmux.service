[Unit]
Description=Cloud Terminal persistent terminal sessions
After=network.target

[Service]
Type=simple
User=user
Group=user
Environment=HOME=/home/user
Environment=SHELL=/bin/bash
Environment=PATH=/home/user/.bun/bin:/home/user/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/tmux -D -L cloud-terminal -f /opt/cloud-terminal/current/tmux.conf
Restart=on-failure
RestartSec=2s
KillMode=control-group
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
