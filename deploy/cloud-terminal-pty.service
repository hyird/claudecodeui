# Template: scripts/deploy.sh and scripts/deploy-local.sh render the @-delimited
# placeholders through deploy/render-unit.sh.
#
# Deliberately unsandboxed: this unit hosts the user's interactive shells.
# Before systemd 255 every seccomp-based option (LockPersonality=,
# RestrictAddressFamilies=, ProtectKernel*=, ...) implies NoNewPrivileges= for
# a User= service, which breaks sudo. Mount-namespace options would hide the
# shells' mounts and /tmp from the rest of the host.
[Unit]
Description=Cloud Terminal persistent node-pty service

[Service]
Type=simple
User=@USER@
Group=@GROUP@
# Not the release directory: deployments replace it while this service keeps
# running.
WorkingDirectory=~
RuntimeDirectory=cloud-terminal
RuntimeDirectoryMode=0700
Environment=HOME=@HOME@
Environment=SHELL=/bin/bash
Environment=PATH=@NODE_DIR@:@HOME@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CLOUDCLI_PTY_SOCKET=/run/cloud-terminal/pty.sock
ExecStart=@NODE@ @BASE@/current/pty-broker.js
Restart=on-failure
RestartSec=2s
KillMode=control-group
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
