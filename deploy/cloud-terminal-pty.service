[Unit]
Description=Cloud Terminal persistent bun-pty service
After=network.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/opt/cloud-terminal/current
RuntimeDirectory=cloud-terminal
RuntimeDirectoryMode=0700
Environment=HOME=/home/user
Environment=SHELL=/bin/bash
Environment=PATH=/home/user/.bun/bin:/home/user/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=BUN_PTY_LIB=/opt/cloud-terminal/current/librust_pty.so
Environment=CLOUDCLI_PTY_SOCKET=/run/cloud-terminal/pty.sock
ExecStart=/home/user/.bun/bin/bun /opt/cloud-terminal/current/pty-broker.js
Restart=on-failure
RestartSec=2s
KillMode=control-group
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
